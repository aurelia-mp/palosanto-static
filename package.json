{
  "name": "palosantohotel",
  "version": "1.0.0",
  "type": "module",
  "main": "js/main.js",
  "scripts": {
    "dev": "npx tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "hreflang": "node scripts/hreflang.mjs",
    "hreflang:check": "node scripts/hreflang.mjs --check",
    "build": "npm run hreflang:check && npx tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "serve": "npx serve . -l 4321",
    "start": "npm run build && npm run serve",
    "optimize:images": "node optimize-images.js",
    "optimize:clean": "rimraf images/* && mkdir -p images/{hero,heroMobile,hotel,gallery,thumbnails}"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "rimraf": "^6.1.0",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "sharp": "^0.34.4"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": ""
}
